# Non-sensitive local runtime settings copied from the source environment. All credentials are intentionally blank.
# Runtime
HOSTNAME=localhost
PORT=5000

# OpenAI-compatible chat-completions API
# Examples of compatible services include OpenAI, Volcengine Ark, SiliconFlow,
# or a local gateway such as Ollama/vLLM exposing /chat/completions.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY= # fill in securely for the receiving environment
AI_MODEL=deepseek-v4-flash
AI_REQUEST_TIMEOUT_MS=60000
ENABLE_FAST_DEBUG=true

# Supabase
# Local defaults are printed by `pnpm supabase:start`.
SUPABASE_URL=https://dmxmhmzntbejtekmnfoh.supabase.co
SUPABASE_ANON_KEY= # fill in securely for the receiving environment
# Server-only. Never expose this key through NEXT_PUBLIC_* or browser code.
SUPABASE_SERVICE_ROLE_KEY= # fill in securely for the receiving environment

# TypeSafe Jev/System One decision API (server-only; optional unless running
# `pnpm local:check:jev`). Jev returns typed decisions rather than prose.
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY= # fill in securely for the receiving environment
JEV_MODEL=jev-latest
JEV_REQUEST_TIMEOUT_MS=30000

# 原 AI_* 不删除，仍供现有游戏使用

DEEPSEEK_AI_BASE_URL=https://api.deepseek.com
DEEPSEEK_AI_API_KEY= # fill in securely for the receiving environment
DEEPSEEK_AI_MODEL=deepseek-flash

DOUBAO_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_AI_API_KEY= # fill in securely for the receiving environment
DOUBAO_AI_MODEL=doubao-seed-2-0-lite-260428

# Alibaba Cloud Model Studio OpenAI-compatible API. Replace {WorkspaceId} with
# the workspace ID for your region; the API key must belong to the same region.
QWEN_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_AI_API_KEY= # fill in securely for the receiving environment
QWEN_AI_MODEL=qwen-plus
QWEN_AI_REQUEST_TIMEOUT_MS=60000
