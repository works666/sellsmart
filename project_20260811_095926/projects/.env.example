# Runtime
HOSTNAME=localhost
PORT=5000

# OpenAI-compatible chat-completions API
# Examples of compatible services include OpenAI, Volcengine Ark, SiliconFlow,
# or a local gateway such as Ollama/vLLM exposing /chat/completions.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_MS=60000

# Named server-side providers for designer AI interface switching; DeepSeek and
# Doubao are also used by /designer/dialogue-prompts A/B testing.
# These are server-only and intentionally do not fall back to AI_*.
DEEPSEEK_AI_BASE_URL=https://api.deepseek.com
DEEPSEEK_AI_API_KEY=
DEEPSEEK_AI_MODEL=deepseek-v4-flash
DEEPSEEK_AI_REQUEST_TIMEOUT_MS=60000

# Volcengine Ark OpenAI-compatible endpoint. Model can be an activated Model ID
# or an Endpoint ID (ep-...) available to the same Ark API key.
DOUBAO_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_AI_API_KEY=
DOUBAO_AI_MODEL=
DOUBAO_AI_REQUEST_TIMEOUT_MS=60000

# Alibaba Cloud Model Studio OpenAI-compatible API. Replace {WorkspaceId} with
# the workspace ID for your region; the API key must belong to the same region.
QWEN_AI_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_AI_API_KEY=
QWEN_AI_MODEL=qwen-plus
QWEN_AI_REQUEST_TIMEOUT_MS=60000

# TypeSafe Jev/System One decision API (server-only; optional unless running
# `pnpm local:check:jev`). Jev returns typed decisions rather than prose.
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_REQUEST_TIMEOUT_MS=30000

# Supabase
# Local defaults are printed by `pnpm supabase:start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server-only. Never expose this key through NEXT_PUBLIC_* or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Session token signing (HMAC-SHA256). Optional; if unset, falls back to
# SUPABASE_SERVICE_ROLE_KEY, then SUPABASE_ANON_KEY.
SESSION_SECRET=
# Optional dedicated secret for deterministic game probability decisions.
# If omitted, the server falls back to SESSION_SECRET or the service-role key.
GAME_RANDOM_SECRET=
