loglevel=error
registry=https://registry.npmmirror.com

strictStorePkgContentCheck=false
verifyStoreIntegrity=false

# 网络优化
network-concurrency=16
fetch-retries=3
fetch-timeout=60000

# 严格使用 peer dependencies
strict-peer-dependencies=false

# 自动生成 lockfile
auto-install-peers=true

# lockfile 配置
lockfile=true
prefer-frozen-lockfile=true

# 如果 lockfile 存在但过期，更新而不是失败
resolution-mode=highest

# 不提示 npm 更新
update-notifier=false

# pnpm 11 may be present on a host even though this project is pinned to pnpm 9.
# Do not trigger an implicit network install before running an existing script.
verify-deps-before-run=warn
